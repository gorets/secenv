#compdef secenv
# zsh completion for secenv: subcommands, profile names, and whatever the
# wrapped command normally completes after `--`.

_secenv_profiles() {
  local dir=${SECENV_HOME:-$HOME/.config/secenv}/profiles
  local -a profiles
  profiles=(${${(f)"$(command ls -- "$dir" 2>/dev/null)"}%.age})
  _describe -t profiles 'profile' profiles
}

_secenv() {
  local -a cmds
  cmds=(
    'setup:install dependencies, create the key, set up completion'
    'init:create the Secure Enclave key'
    'completion:print the shell completion script'
    'update:update a global npm install'
    'set:enter secret values'
    'import:import an existing .env file'
    'profile:manage profiles (ls, rm, mv, cp, export, trust)'
    'list:list profiles, or the secrets of one'
    'ls:same as list'
    'get:print one secret value (terminal only)'
    'rm:remove secrets'
    'run:run a command with secrets in its environment'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'secenv command' cmds
    return
  fi

  case $words[2] in
    set|list|ls|rm|get)
      (( CURRENT == 3 )) && _secenv_profiles
      ;;
    profile|profiles)
      if (( CURRENT == 3 )); then
        _alternative \
          'actions:action:((ls\:"list profiles" rm\:"delete a profile" mv\:"rename a profile" cp\:"copy a profile" export\:"print a profile in .env format" trust\:"manage directory approvals"))' \
          'profiles:profile:_secenv_profiles'
      elif (( CURRENT == 4 )) && [[ $words[3] == (rm|mv|cp|export) ]]; then
        _secenv_profiles
      elif [[ $words[3] == export && $words[CURRENT-1] == --out ]]; then
        _files
      elif (( CURRENT > 4 )) && [[ $words[3] == export ]]; then
        _values 'option' '--out[write a 0600 file]' '--allow-pipe[allow writing into a pipe]'
      elif (( CURRENT == 4 )) && [[ $words[3] == trust ]]; then
        _values 'trust action' 'ls[list approved directories]' 'list[same as ls]' 'rm[revoke an approval]' 'prune[remove approvals of deleted directories]'
      elif (( CURRENT == 5 )) && [[ $words[3] == trust ]]; then
        case $words[4] in
          ls|list) _secenv_profiles ;;
          rm) _directories ;;
        esac
      fi
      ;;
    completion)
      (( CURRENT == 3 )) && _values 'shell' zsh
      ;;
    import)
      if (( CURRENT == 3 )); then
        _secenv_profiles
      elif [[ $words[CURRENT-1] == --only ]]; then
        _message 'KEY,KEY'
      else
        _alternative 'files:file:_files' \
          'options:option:(--all --only --rewrite --keep)'
      fi
      ;;
    run)
      local i sep=0
      for (( i = 3; i < CURRENT; i++ )); do
        [[ $words[i] == -- ]] && { sep=$i; break; }
      done
      if (( sep )); then
        # Hand the rest of the line to the wrapped command's own completion.
        words=("${(@)words[sep+1,-1]}")
        (( CURRENT -= sep ))
        _normal
      elif [[ $words[CURRENT-1] == (--env|--public-env) ]]; then
        _files
      else
        # Profile names; the <profile>/KEY form is typed by hand (keys need Touch ID).
        _alternative \
          'profiles:profile:_secenv_profiles' \
          'options:option:(--env --no-env --)'
      fi
      ;;
  esac
}

# Autoloaded from fpath: run as the completion function. Sourced (for example
# `source <(secenv completion zsh)` after compinit): register it instead.
if [[ $funcstack[1] == _secenv ]]; then
  _secenv "$@"
else
  compdef _secenv secenv
fi
